{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "jsx": "preserve"
  },
  "include": ["plugins/**/*.ts", "plugins/**/*.tsx", "test/**/*.ts"]
}
